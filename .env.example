# Root .env for docker-compose variable substitution (roadmap 4.2).
# Copy to .env and set real values:  cp .env.example .env
# NOTE: application config (integration URLs, secrets, etc.) lives in
# life-claim-backend/.env, which the backend + worker services load via env_file.

# --- MySQL (compose-managed) ---
DB_DATABASE=claims_poc
DB_USER=claims
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- RabbitMQ (compose-managed) ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- Host port the frontend (nginx) is published on ---
FRONTEND_PORT=8088
